{
  "name": "@octo/desktop",
  "productName": "Octo",
  "version": "0.1.0",
  "description": "Octo: la memoria del progetto e i suoi deliverable, sul PC del Project Manager.",
  "author": "Octo",
  "private": true,
  "type": "module",
  "main": "dist/main/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "dist": "node scripts/build.mjs && electron-builder --config electron-builder.yml --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@octo/application": "workspace:*",
    "@octo/domain": "workspace:*",
    "@octo/infrastructure": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "vite": "8.3.5",
    "zod": "4.6.7"
  }
}
