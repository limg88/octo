{
  "name": "octo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @octo/desktop dev",
    "build": "pnpm --filter @octo/desktop build",
    "dist": "pnpm --filter @octo/desktop dist",
    "db:setup": "bash scripts/db-setup.sh",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check . && pnpm arch",
    "arch": "depcruise packages apps --config .dependency-cruiser.cjs",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:recinto": "vitest run --config vitest.recinto.config.ts",
    "release:keys": "node scripts/release-keys.mjs",
    "release:passphrase": "node scripts/release-rekey.mjs",
    "release:sign": "node scripts/release-sign.mjs",
    "e2e": "pnpm build && node e2e/app.e2e.mjs",
    "e2e:cruscotto": "pnpm build && node e2e/cruscotto.e2e.mjs",
    "e2e:commessa": "pnpm build && node e2e/commessa.e2e.mjs",
    "e2e:riunioni": "pnpm build && node e2e/riunioni.e2e.mjs",
    "e2e:recinto": "pnpm build && node e2e/recinto.e2e.mjs",
    "e2e:script": "pnpm build && node e2e/script.e2e.mjs",
    "e2e:catalogo": "pnpm build && node e2e/catalogo.e2e.mjs",
    "e2e:memoria": "pnpm build && node e2e/memoria.e2e.mjs",
    "e2e:correggi": "pnpm build && node e2e/correggi.e2e.mjs",
    "e2e:esiti": "pnpm build && node e2e/esiti.e2e.mjs",
    "e2e:condivisa": "pnpm build && node e2e/condivisa.e2e.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "^18.7.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
